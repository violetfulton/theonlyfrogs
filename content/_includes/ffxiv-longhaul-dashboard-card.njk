{#
  Replace the previous Long Haul dashboard placeholder/article with:

    {% include "ffxiv-longhaul-dashboard-card.njk" %}

  This version intentionally has no progress tracking and no localStorage.
#}

<article
  class="ff-card
         ff-home-project-card
         ff-home-project-card--longhaul"
>
  <div class="ff-home-project-card__head">
    <div
      class="ff-home-project-card__icon"
      aria-hidden="true"
    >
      ⌛
    </div>

    <div>
      <span class="ff-home-project-card__eyebrow">
        Forever grind
      </span>

      <h3>
        Long Haul
      </h3>
    </div>

    <span
      class="ff-home-project-card__number
             ff-home-project-card__number--soft"
    >
      ∞
    </span>
  </div>


  <p class="ff-home-project-card__intro">
    Huge background projects for when I want to play FFXIV
    but don't have one specific plan.
  </p>


  <div class="ff-home-project-tags">
    <span>☁ Diadem</span>
    <span>⚒ Firmament</span>
    <span>☽ Cosmic</span>
    <span>⚔ Hunts</span>
    <span>🏹 PvP</span>
    <span>◇ Deep Dungeon</span>
  </div>


  <div class="ff-home-project-next">
    <span>
      ✦ no spreadsheet required
    </span>

    <strong>
      Pick something horrible
    </strong>

    <small>
      The game can keep the exact counter. I just need
      something to go do.
    </small>
  </div>


  <div class="ff-home-project-actions">
    <a
      class="ff-button ff-button--primary"
      href="/shrines/finalfantasyxiv/long-haul/"
    >
      Browse ideas →
    </a>

    <a
      class="ff-button"
      href="/shrines/finalfantasyxiv/long-haul/?pick=1"
    >
      🎲 Pick one
    </a>
  </div>
</article>
