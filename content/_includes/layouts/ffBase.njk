<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title or "Final Fantasy XIV" }} | TheOnlyFrogs</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <meta
    name="description"
    content="{{ description or 'A soft little Final Fantasy XIV shrine on TheOnlyFrogs — progress logs, achievements, screenshots, glams, housing, and Eorzean miscellany.' }}"
  >
  <meta name="theme-color" content="#f7b3db">

  <link rel="stylesheet" href="/assets/css/ffxiv/ffxiv-base.css">

  {% if customcss %}
    <link rel="stylesheet" href="{{ customcss }}">
  {% endif %}

  {% if extraCss %}
    {% for sheet in extraCss %}
      <link rel="stylesheet" href="{{ sheet }}">
    {% endfor %}
  {% endif %}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Gaegu:wght@400;700&family=Quicksand:wght@400;500;600;700&display=swap"
    rel="stylesheet"
  >
</head>

<body class="ff-body">
  <div class="ff-bg" aria-hidden="true">
    <div class="ff-bg__stars"></div>
    <div class="ff-bg__glow ff-bg__glow--one"></div>
    <div class="ff-bg__glow ff-bg__glow--two"></div>
    <div class="ff-bg__glow ff-bg__glow--three"></div>
  </div>

  {% set currentUrl = page.url or "/" %}
  {% set navItems = [
    { label: "Home", icon: "✦", href: "/shrines/finalfantasyxiv/", match: "exact" },
    { label: "Achievements", icon: "★", href: "/shrines/finalfantasyxiv/achievements/", match: "prefix" },
    { label: "Checklist", icon: "✓", href: "/shrines/finalfantasyxiv/checklist/", match: "prefix" },
    { label: "Housing", icon: "⌂", href: "/shrines/finalfantasyxiv/housing/", match: "prefix" },
    { label: "Glams", icon: "✧", href: "/shrines/finalfantasyxiv/glams/", match: "prefix" },
    { label: "Gil", icon: "◇", href: "/shrines/finalfantasyxiv/gil/", match: "prefix" }
  ] %}

  <div class="ff-shell">
    <div class="ff-topline">
      <a href="/">TheOnlyFrogs</a>
      <span aria-hidden="true">/</span>
      <a href="/shrines/">Shrines</a>
      <span aria-hidden="true">/</span>
      <span>Final Fantasy XIV</span>
    </div>

    <header class="ff-header">
      <a href="/shrines/finalfantasyxiv/" class="ff-brand" aria-label="Final Fantasy XIV shrine home">
        <span class="ff-brand__kicker">✦ the crystal archives ✦</span>
        <span class="ff-brand__title">{{ shrineTitle or "Final Fantasy XIV" }}</span>
        <span class="ff-brand__subtitle">
          {{ shrineSubtitle or "a soft little Eorzean journal of progress, treasures & tiny obsessions" }}
        </span>
      </a>

      <div class="ff-crystal-mark" aria-hidden="true">
        <span class="ff-crystal-mark__spark ff-crystal-mark__spark--one">✦</span>
        <span class="ff-crystal-mark__gem ff-crystal-mark__gem--back"></span>
        <span class="ff-crystal-mark__gem ff-crystal-mark__gem--front"></span>
        <span class="ff-crystal-mark__spark ff-crystal-mark__spark--two">✧</span>
      </div>
    </header>

    <div class="ff-nav-wrap">
      <nav class="ff-nav" aria-label="Final Fantasy XIV shrine navigation">
        {% for item in navItems %}
          {% set isActive = false %}

          {% if item.match == "prefix" %}
            {% if currentUrl.startsWith(item.href) %}
              {% set isActive = true %}
            {% endif %}
          {% else %}
            {% if currentUrl == item.href %}
              {% set isActive = true %}
            {% endif %}
          {% endif %}

          <a
            href="{{ item.href }}"
            class="ff-nav__link{% if isActive %} is-active{% endif %}"
            {% if isActive %}aria-current="page"{% endif %}
          >
            <span class="ff-nav__icon" aria-hidden="true">{{ item.icon }}</span>
            <span>{{ item.label }}</span>
          </a>
        {% endfor %}
      </nav>

      <div class="ff-nav-returns" aria-label="Return navigation">
        <a href="/shrines/">All shrines</a>
        <a href="/">Site home</a>
      </div>
    </div>

    {% if intro %}
      <section class="ff-intro-card">
        <span class="ff-intro-card__spark" aria-hidden="true">✦</span>
        <div>{{ intro | safe }}</div>
      </section>
    {% endif %}

    <main class="ff-main">
      {{ content | safe }}
    </main>

    <footer class="ff-footer">
      <span class="ff-footer__rule" aria-hidden="true"></span>
      <p>✦ wandering Eorzea one little goal at a time ✦</p>
      <div class="ff-footer__links">
        <a href="/shrines/">all shrines</a>
        <span aria-hidden="true">♡</span>
        <a href="/">theonlyfrogs.com</a>
      </div>
    </footer>
  </div>

  {% if pageScripts %}
    {% for script in pageScripts %}
      <script src="{{ script }}"></script>
    {% endfor %}
  {% endif %}
</body>
</html>
