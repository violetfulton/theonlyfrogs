---
title: Violet's PokéNav
layout: layouts/pokeBase.njk
permalink: /shrines/pokemon/
customcss: "/assets/css/shrines/pokemon/pokemon-v2.css"
---

<div class="poke-v2">
  {% include "components/pokemon/pokenav.njk" %}

  <main class="pkmn-screen pkmn-home">
    <header class="pkmn-titlebar">
      <div>
        <p class="pkmn-kicker">TRAINER SYSTEM / ONLINE</p>
        <h1>VIOLET'S POKéNAV</h1>
      </div>
      <span class="pkmn-status-light" aria-hidden="true"></span>
    </header>

    <section class="pkmn-continue">
      <div class="pkmn-continue__label">CONTINUE</div>
      <div class="pkmn-continue__main">
        <div class="pkmn-trainer-emblem" aria-hidden="true">
          <span class="pkmn-ball pkmn-ball--large"></span>
        </div>
        <div>
          <p class="pkmn-eyebrow">TRAINER</p>
          <h2>VIOLET</h2>
          {% if pokemon.latest %}
            <p class="pkmn-muted">Latest adventure: {{ pokemon.latest.originGame }}</p>
          {% else %}
            <p class="pkmn-muted">Pokémon journey archive</p>
          {% endif %}
        </div>
        <dl class="pkmn-save-stats">
          <div><dt>SHINIES</dt><dd>{{ pokemon.stats.captures }}</dd></div>
          <div><dt>DEX</dt><dd>{{ pokemon.stats.unique }} / {{ pokemon.stats.dexTotal }}</dd></div>
          <div><dt>HUNTS</dt><dd>{{ pokemon.stats.activeHunts }}</dd></div>
        </dl>
      </div>
    </section>

    <div class="pkmn-home-grid">
      <section class="pkmn-panel pkmn-latest">
        <div class="pkmn-panel__head">
          <span>NEWEST SHINY</span>
          <span>✦</span>
        </div>
        {% if pokemon.latest %}
          <div class="pkmn-latest__body">
            <div class="pkmn-sprite-stage">
              {% if pokemon.latest.image %}<img src="{{ pokemon.latest.image }}" alt="Shiny {{ pokemon.latest.species }}">{% endif %}
            </div>
            <div>
              <p class="pkmn-dexno">No. {{ pokemon.latest.dexDisplay }}</p>
              <h2>{{ pokemon.latest.nickname or pokemon.latest.species }}</h2>
              {% if pokemon.latest.nickname %}<p class="pkmn-species-name">{{ pokemon.latest.species }}</p>{% endif %}
              <p>{{ pokemon.latest.originGame }}</p>
              <p class="pkmn-muted">{{ pokemon.latest.caughtDate }}{% if pokemon.latest.location %} · {{ pokemon.latest.location }}{% endif %}</p>
              <a class="pkmn-text-link" href="/shrines/pokemon/shinies/">Open PC Boxes →</a>
            </div>
          </div>
        {% else %}
          <div class="pkmn-empty">No captures recorded.</div>
        {% endif %}
      </section>

      <section class="pkmn-panel pkmn-dex-widget">
        <div class="pkmn-panel__head"><span>SHINY DEX</span><span>{{ pokemon.stats.dexPercent }}%</span></div>
        <div class="pkmn-dex-widget__number">{{ pokemon.stats.unique }}</div>
        <div class="pkmn-progress" aria-label="Shiny Pokédex progress">
          <span style="width: {{ pokemon.stats.dexPercent }}%"></span>
        </div>
        <p>{{ pokemon.stats.unique }} unique species recorded from {{ pokemon.stats.captures }} captures.</p>
        <a class="pkmn-text-link" href="/shrines/pokemon/dex/">Open Pokédex →</a>
      </section>
    </div>

    <section class="pkmn-command-grid" aria-label="PokéNav menu">
      <a href="/shrines/pokemon/dex/"><span class="pkmn-command-icon">01</span><strong>POKéDEX</strong><small>National shiny progress</small></a>
      <a href="/shrines/pokemon/shinies/"><span class="pkmn-command-icon">02</span><strong>PC BOXES</strong><small>{{ pokemon.stats.captures }} shiny captures</small></a>
      <a href="/shrines/pokemon/hunts/"><span class="pkmn-command-icon">03</span><strong>HUNT BOARD</strong><small>{{ pokemon.stats.activeHunts }} active</small></a>
      <a href="/shrines/pokemon/trainer/"><span class="pkmn-command-icon">04</span><strong>TRAINER</strong><small>Trainer card + favourites</small></a>
      <a href="/shrines/pokemon/journeys/"><span class="pkmn-command-icon">05</span><strong>JOURNEYS</strong><small>Save files + teams</small></a>
      <a href="/shrines/pokemon/records/"><span class="pkmn-command-icon">06</span><strong>RECORDS</strong><small>Milestones + victories</small></a>
      <a href="/shrines/pokemon/collection/"><span class="pkmn-command-icon">07</span><strong>COLLECTION</strong><small>Games + shelf collection</small></a>
    </section>

    {% if pokemon.recent.length %}
      <section class="pkmn-panel">
        <div class="pkmn-panel__head"><span>RECENT PARTY</span><span>LAST {{ pokemon.recent.length }}</span></div>
        <div class="pkmn-party-strip">
          {% for mon in pokemon.recent %}
            <a href="/shrines/pokemon/shinies/" title="{{ mon.species }} · {{ mon.originGame }}">
              {% if mon.image %}<img src="{{ mon.image }}" alt="">{% endif %}
              <span>{{ mon.species }}</span>
            </a>
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <footer class="pkmn-controls"><span>▲▼ SELECT</span><span>A OPEN</span><a href="/">B MAIN SITE</a></footer>
  </main>
</div>
