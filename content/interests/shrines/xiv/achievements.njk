---
title: FFXIV Achievements
layout: layouts/ffBase.njk
permalink: /shrines/finalfantasyxiv/achievements/
customcss: "/assets/css/ffxiv/achievements.css"
---

{% set d = ffxivAchievementDashboard %}

<div class="ach-dashboard">
  <section class="ach-intro">
    <p class="ach-kicker">✦ achievement journal ✦</p>
    <h1>What could I work on next?</h1>
    <p>
      A little progress dashboard for {{ d.character.name }} — what I’ve earned, how much of the
      obtainable achievement-point pool I’ve cleared, and some sensible places to look next ♡
    </p>
  </section>

  {% if not d.sourceOk %}
    <aside class="ach-notice ach-notice--error">
      <strong>Achievement data didn’t refresh this build.</strong>
      <span>{{ d.error }}</span>
      <a href="{{ d.character.achievementUrl }}">Open Lodestone ↗</a>
    </aside>
  {% endif %}

  <section class="ach-hero-card">
    <div class="ach-character">
      <div class="ach-character__image-wrap">
        {% if d.character.portrait %}
          <img class="ach-character__image" src="{{ d.character.portrait }}" alt="{{ d.character.name }}">
        {% elseif d.character.avatar %}
          <img class="ach-character__image ach-character__image--avatar" src="{{ d.character.avatar }}" alt="{{ d.character.name }}">
        {% else %}
          <div class="ach-character__placeholder">✦</div>
        {% endif %}
      </div>

      <div class="ach-character__copy">
        {% if d.character.title %}<p class="ach-character__title">{{ d.character.title }}</p>{% endif %}
        <h2>{{ d.character.name }}</h2>
        <p>{{ d.character.worldDisplay }}</p>
        <a class="ach-text-link" href="{{ d.character.achievementUrl }}">Lodestone achievements ↗</a>
      </div>
    </div>

    <div class="ach-main-stat">
      <span class="ach-main-stat__eyebrow">Achievement Points</span>
      <strong class="ach-main-stat__value">{{ d.points.totalDisplay }}</strong>

      <div class="ach-completion-head">
        <span>Obtainable AP completion</span>
        <strong>{{ d.points.obtainablePercentDisplay }}</strong>
      </div>
      <div class="ach-progress" aria-label="{{ d.points.obtainablePercentDisplay }} of obtainable achievement points earned">
        <span style="width: {{ d.points.obtainablePercent }}%"></span>
      </div>
      <p class="ach-progress-caption">
        {{ d.points.obtainableEarnedDisplay }} / {{ d.points.obtainableTotalDisplay }} obtainable points
      </p>
    </div>

    <div class="ach-stat-grid">
      <div class="ach-mini-stat">
        <span>Earned</span>
        <strong>{{ d.points.earnedCountDisplay }}</strong>
        <small>achievements</small>
      </div>
      <div class="ach-mini-stat">
        <span>Obtainable count</span>
        <strong>{{ d.points.obtainableCountPercentDisplay }}</strong>
        <small>{{ d.points.obtainableEarnedCountDisplay }} / {{ d.points.obtainableCountDisplay }}</small>
      </div>
      <div class="ach-mini-stat">
        <span>Still available</span>
        <strong>{{ d.points.obtainableRemainingDisplay }}</strong>
        <small>achievement points</small>
      </div>
    </div>
  </section>

  <section class="ach-section ach-milestone">
    <div class="ach-section-heading">
      <div>
        <p class="ach-section-kicker">♡ next little number goal</p>
        <h2>{{ d.points.totalDisplay }} → {{ d.nextMilestone.targetDisplay }}</h2>
      </div>
      <span class="ach-pill">{{ d.nextMilestone.neededDisplay }} pts to go</span>
    </div>

    <div class="ach-milestone__layout">
      <div class="ach-milestone__summary">
        <strong>{{ d.nextMilestone.neededDisplay }}</strong>
        <span>points until the next 250-point milestone</span>
        {% if d.nextMilestone.plan.achievements.length %}
          <p>
            The suggestion pool below contains <b>{{ d.nextMilestone.plan.totalDisplay }}</b> before
            you even have to look deeper into the catalogue.
          </p>
        {% endif %}
      </div>

      <div class="ach-milestone__list">
        {% for a in d.nextMilestone.plan.achievements %}
          {% if loop.index <= 6 %}
          <a class="ach-plan-row" href="{{ a.url }}">
            <span>
              <b>{{ a.name }}</b>
              <small>{{ a.type }}{% if a.ownedDisplay %} · {{ a.ownedDisplay }}{% endif %}</small>
            </span>
            <strong>{{ a.pointsDisplay }}</strong>
          </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>

  <section class="ach-section">
    <div class="ach-section-heading">
      <div>
        <p class="ach-section-kicker">✦ point planner</p>
        <h2>How far do I feel like pushing it?</h2>
        <p>These are suggestion bundles, not time estimates — pick a point goal and steal whatever sounds fun.</p>
      </div>
    </div>

    <div class="ach-target-tabs" role="tablist" aria-label="Achievement point targets">
      {% for plan in d.targetPlans %}
        <button
          class="ach-target-tab{% if loop.index == 3 %} is-active{% endif %}"
          type="button"
          role="tab"
          aria-selected="{% if loop.index == 3 %}true{% else %}false{% endif %}"
          data-ach-target="{{ plan.target }}">
          {{ plan.targetDisplay }} pts
        </button>
      {% endfor %}
    </div>

    <div class="ach-target-panels">
      {% for plan in d.targetPlans %}
        <div class="ach-target-panel{% if loop.index == 3 %} is-active{% endif %}" data-ach-panel="{{ plan.target }}">
          <div class="ach-target-panel__head">
            <div>
              <strong>A {{ plan.targetDisplay }} point idea pile</strong>
              <span>{{ plan.achievements.length }} suggested achievements · {{ plan.totalDisplay }} potential</span>
            </div>
            {% if plan.covered %}<span class="ach-pill ach-pill--good">enough ideas ✓</span>{% endif %}
          </div>

          <div class="ach-suggestion-grid ach-suggestion-grid--compact">
            {% for a in plan.achievements %}
              <a class="ach-suggestion" href="{{ a.url }}">
                <div class="ach-suggestion__top">
                  <span class="ach-type-tag">{{ a.type }}</span>
                  <strong>{{ a.pointsDisplay }}</strong>
                </div>
                <h3>{{ a.name }}</h3>
                <p>{{ a.description }}</p>
                <div class="ach-suggestion__meta">
                  {% if a.ownedDisplay %}<span>{{ a.ownedDisplay }}</span>{% endif %}
                  {% if a.category %}<span>{{ a.category }}</span>{% endif %}
                </div>
              </a>
            {% endfor %}
          </div>
        </div>
      {% endfor %}
    </div>
  </section>

  <section class="ach-section">
    <div class="ach-section-heading">
      <div>
        <p class="ach-section-kicker">♡ momentum</p>
        <h2>What I’ve been earning lately</h2>
      </div>
    </div>

    <div class="ach-momentum-grid">
      {% for row in d.momentum %}
        <div class="ach-momentum-card">
          <span>{{ row.label }}</span>
          <strong>{{ row.pointsDisplay }} pts</strong>
          <small>{{ row.achievements }} achievements</small>
        </div>
      {% endfor %}
    </div>

    {% if d.monthlyHistory.length %}
      <div class="ach-history-card">
        <div class="ach-history-card__head">
          <strong>Monthly AP gains</strong>
          <span>based on Lodestone achievement dates</span>
        </div>
        <div class="ach-history-bars">
          {% for month in d.monthlyHistory %}
            <div class="ach-history-bar">
              <div class="ach-history-bar__track">
                <span style="height: {{ month.barPercent }}%" title="{{ month.pointsDisplay }} pts"></span>
              </div>
              <strong>{{ month.pointsDisplay }}</strong>
              <small>{{ month.label }}</small>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
  </section>

  <section class="ach-section">
    <div class="ach-section-heading">
      <div>
        <p class="ach-section-kicker">✦ where the points live</p>
        <h2>Progress by category</h2>
        <p>These bars use obtainable AP, so retired/Legacy/seasonal ranking junk does not poison the percentages.</p>
      </div>
    </div>

    <div class="ach-category-grid">
      {% for category in d.categories %}
        <article class="ach-category-card">
          <div class="ach-category-card__title">
            <span class="ach-category-card__icon">{{ category.icon }}</span>
            <div>
              <h3>{{ category.name }}</h3>
              <p>{{ category.blurb }}</p>
            </div>
          </div>

          <div class="ach-category-card__numbers">
            <strong>{{ category.percentDisplay }}</strong>
            <span>{{ category.earnedPointsDisplay }} / {{ category.totalPointsDisplay }} pts</span>
          </div>
          <div class="ach-progress ach-progress--small">
            <span style="width: {{ category.percent }}%"></span>
          </div>
          <p class="ach-category-card__remaining">
            {{ category.remainingPointsDisplay }} pts remaining · {{ category.earnedCount }}/{{ category.totalCount }} achievements
          </p>

          {% if category.suggestions.length %}
            <div class="ach-category-next">
              <span>Somewhere to look next</span>
              {% for a in category.suggestions %}
                <a href="{{ a.url }}"><b>{{ a.name }}</b><em>{{ a.pointsDisplay }}</em></a>
              {% endfor %}
            </div>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="ach-two-column">
    <section class="ach-section ach-section--nested">
      <div class="ach-section-heading">
        <div>
          <p class="ach-section-kicker">🌱 likely easier</p>
          <h2>Common missing achievements</h2>
          <p>High public ownership is a useful hint that these may be less awful than the deep grinds.</p>
        </div>
      </div>

      <div class="ach-stack">
        {% for a in d.quickWins %}
          <a class="ach-stack-card" href="{{ a.url }}">
            <div><span>{{ a.type }}</span><h3>{{ a.name }}</h3><p>{{ a.description }}</p></div>
            <aside><strong>{{ a.pointsDisplay }}</strong>{% if a.ownedDisplay %}<small>{{ a.ownedDisplay }}</small>{% endif %}</aside>
          </a>
        {% else %}
          <p class="ach-empty">No obvious common missing achievements found this build ♡</p>
        {% endfor %}
      </div>
    </section>

    <section class="ach-section ach-section--nested">
      <div class="ach-section-heading">
        <div>
          <p class="ach-section-kicker">✧ next in a chain</p>
          <h2>Series I’ve already started</h2>
          <p>This means the previous tier is earned — not that the hidden counter is necessarily almost finished.</p>
        </div>
      </div>

      <div class="ach-stack">
        {% for a in d.nextInSeries %}
          <a class="ach-stack-card" href="{{ a.url }}">
            <div><span>{{ a.type }}</span><h3>{{ a.name }}</h3><p>{{ a.description }}</p></div>
            <aside><strong>{{ a.pointsDisplay }}</strong>{% if a.ownedDisplay %}<small>{{ a.ownedDisplay }}</small>{% endif %}</aside>
          </a>
        {% else %}
          <p class="ach-empty">Nothing obvious in a Roman-numeral achievement chain right now ♡</p>
        {% endfor %}
      </div>
    </section>
  </section>

  {% if d.rewards.length %}
    <section class="ach-section">
      <div class="ach-section-heading">
        <div>
          <p class="ach-section-kicker">🎁 shiny little bribes</p>
          <h2>Missing achievements with rewards</h2>
          <p>If I’m going to chase points, I may as well get a title or item out of it too.</p>
        </div>
      </div>

      <div class="ach-suggestion-grid">
        {% for a in d.rewards %}
          <a class="ach-suggestion ach-suggestion--reward" href="{{ a.url }}">
            <div class="ach-suggestion__top">
              <span class="ach-type-tag">{{ a.type }}</span>
              <strong>{{ a.pointsDisplay }}</strong>
            </div>
            <h3>{{ a.name }}</h3>
            <p>{{ a.description }}</p>
            <strong class="ach-reward-label">✦ {{ a.reward }}</strong>
            <div class="ach-suggestion__meta">
              {% if a.ownedDisplay %}<span>{{ a.ownedDisplay }}</span>{% endif %}
              <span>{{ a.category }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
    </section>
  {% endif %}

  <section class="ach-section">
    <div class="ach-section-heading ach-section-heading--row">
      <div>
        <p class="ach-section-kicker">♡ achievement diary</p>
        <h2>Recently earned</h2>
        <p>I still want the page to feel like a record of this character, not only a to-do list.</p>
      </div>
      <a class="ach-button" href="{{ d.character.achievementUrl }}">View all on Lodestone ↗</a>
    </div>

    <div class="ach-recent-list">
      {% for a in d.recent %}
        <a class="ach-recent-row" href="{{ a.url }}">
          <span class="ach-recent-row__spark">✦</span>
          <div class="ach-recent-row__copy">
            <small>{{ a.type }}{% if a.category %} · {{ a.category }}{% endif %}</small>
            <strong>{{ a.name }}</strong>
          </div>
          <div class="ach-recent-row__meta">
            {% if a.pointsDisplay %}<b>{{ a.pointsDisplay }}</b>{% endif %}
            <time datetime="{{ a.earnedAt }}">{{ a.dateDisplay }}</time>
          </div>
        </a>
      {% else %}
        <p class="ach-empty">No recent achievement history found.</p>
      {% endfor %}
    </div>
  </section>

  <aside class="ach-method-note">
    <strong>How this page decides things</strong>
    <p>{{ d.methodology.note }}</p>
    <p>{{ d.methodology.recNote }}</p>
    <small>
      Lodestone dates are synchronization dates, so they can differ slightly from the exact moment an achievement popped in-game.
      Last refreshed: {{ d.updatedDisplay }}.
    </small>
  </aside>
</div>

<script>
  (() => {
    const tabs = [...document.querySelectorAll("[data-ach-target]")];
    const panels = [...document.querySelectorAll("[data-ach-panel]")];
    if (!tabs.length) return;

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const target = tab.dataset.achTarget;
        tabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle("is-active", active);
          item.setAttribute("aria-selected", String(active));
        });
        panels.forEach((panel) => panel.classList.toggle("is-active", panel.dataset.achPanel === target));
      });
    });
  })();
</script>
