---
title: Trainer Records
layout: layouts/pokeBase.njk
permalink: /shrines/pokemon/records/
customcss: "/assets/css/shrines/pokemon/pokemon-v2.css"
---
<div class="poke-v2">{% include "components/pokemon/pokenav.njk" %}<main class="pkmn-screen">
<header class="pkmn-titlebar"><div><p class="pkmn-kicker">TRAINER DATA</p><h1>RECORDS</h1></div><strong>{{ pokemon.records.length }}</strong></header>
{% if pokemon.records.length %}<div class="pkmn-record-grid">{% for record in pokemon.records %}<article class="pkmn-record"><span>{{ record.type }}</span>{% if record.image %}<img src="{{ record.image }}" alt="">{% endif %}<h2>{{ record.title }}</h2><p>{{ record.game }}</p><small>{{ record.date }}</small>{% if record.description %}<p>{{ record.description }}</p>{% endif %}</article>{% endfor %}</div>{% else %}<div class="pkmn-empty"><strong>RECORD CASE EMPTY</strong><span>No trainer records registered.</span></div>{% endif %}
<footer class="pkmn-controls"><a href="/shrines/pokemon/">B POKéNAV</a></footer></main></div>
