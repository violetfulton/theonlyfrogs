---
title: PC Boxes
layout: layouts/pokeBase.njk
permalink: /shrines/pokemon/shinies/
customcss: "/assets/css/shrines/pokemon/pokemon-v2.css"
---
<div class="poke-v2">
  {% include "components/pokemon/pokenav.njk" %}
  <main class="pkmn-screen">
    <header class="pkmn-titlebar"><div><p class="pkmn-kicker">VIOLET'S PC</p><h1>PC BOXES</h1></div><strong>{{ pokemon.stats.captures }} ✦</strong></header>
    <section class="pkmn-pc-shell">
      <div class="pkmn-pc-toolbar">
        <label>SEARCH <input type="search" id="pc-search" placeholder="Species, game, method…"></label>
        <span>{{ pokemon.stats.unique }} unique species</span>
      </div>
      <div class="pkmn-pc-grid" id="pc-grid">
        {% for mon in pokemon.captures %}
          <button class="pkmn-pc-slot" type="button"
            data-search="{{ mon.species }} {{ mon.nickname }} {{ mon.originGame }} {{ mon.method }} {{ mon.form }}"
            data-name="{{ mon.nickname or mon.species }}"
            data-species="{{ mon.species }}"
            data-dex="{{ mon.dexDisplay }}"
            data-game="{{ mon.originGame }}"
            data-method="{{ mon.method }}"
            data-date="{{ mon.caughtDate }}"
            data-ball="{{ mon.ball }}"
            data-nature="{{ mon.nature }}"
            data-gender="{{ mon.gender }}"
            data-location="{{ mon.location }}"
            data-odds="{{ mon.odds }}"
            data-encounters="{{ mon.encounters }}"
            data-mark="{{ mon.markRibbon }}"
            data-notes="{{ mon.notes }}"
            data-image="{{ mon.image }}">
            {% if mon.image %}<img src="{{ mon.image }}" alt="" loading="lazy">{% endif %}
            <span>{{ mon.nickname or mon.species }}</span>
            <small>No. {{ mon.dexDisplay }}</small>
          </button>
        {% endfor %}
      </div>
    </section>
    <dialog class="pkmn-summary" id="pokemon-summary">
      <button class="pkmn-summary__close" type="button" data-summary-close aria-label="Close">×</button>
      <div class="pkmn-summary__sprite"><img data-summary-image alt=""></div>
      <div class="pkmn-summary__info">
        <p class="pkmn-dexno" data-summary-dex></p>
        <h2 data-summary-name></h2>
        <p class="pkmn-species-name" data-summary-species></p>
        <dl data-summary-details></dl>
        <p class="pkmn-summary__notes" data-summary-notes></p>
      </div>
    </dialog>
    <footer class="pkmn-controls"><span>A SUMMARY</span><a href="/shrines/pokemon/">B POKéNAV</a></footer>
  </main>
</div>
<script src="/assets/js/shrines/pokemon/pokemon-v2.js" defer></script>
