---
title: "Game Collection"
layout: layouts/gamesBase.njk
permalink: /games/
pageClass: games-index
customcss:
  - /assets/css/games/index.css
---

<section class="games-home-hero">
  <div class="games-home-hero__copy">
    <p class="games-eyebrow">my game shelf ♡</p>
    <h1>Games I own, keep & come back to.</h1>
    <p>
      A little catalogue of my physical shelves and digital libraries.
      Matching copies stay together, so owning the same title physically and digitally is easy to spot without filling the shelf with duplicate cards.
    </p>
  </div>

  <div class="games-home-hero__note" aria-label="Collection note">
    <span class="games-home-hero__pin" aria-hidden="true">✿</span>
    <strong>collection rule</strong>
    <p>one card per title + platform; every actual copy stays tucked inside it.</p>
  </div>
</section>

<section class="games-stats" aria-label="Collection totals">
  <div class="games-stat">
    <strong>{{ gamesOwned.totalGames }}</strong>
    <span>game cards</span>
  </div>
  <div class="games-stat">
    <strong>{{ gamesOwned.totalCopies }}</strong>
    <span>owned copies</span>
  </div>
  <div class="games-stat">
    <strong>{{ gamesOwned.physicalCount }}</strong>
    <span>with physical copies</span>
  </div>
  <div class="games-stat">
    <strong>{{ gamesOwned.digitalCount }}</strong>
    <span>with digital copies</span>
  </div>
  {% if gamesOwned.bothCount %}
  <div class="games-stat games-stat--both">
    <strong>{{ gamesOwned.bothCount }}</strong>
    <span>owned both ways</span>
  </div>
  {% endif %}
</section>

{% if gamesOwned.currentGames and gamesOwned.currentGames.length %}
<section class="games-section games-current">
  <div class="games-section-heading">
    <div>
      <p class="games-eyebrow">right now</p>
      <h2>Currently playing</h2>
    </div>
    <p class="games-section-note">the little pile beside the console</p>
  </div>

  <div class="current-shelf">
    {% for game in gamesOwned.currentGames %}
      {% if loop.index <= 6 %}
      <article class="current-game">
        <img src="{{ game.image or '/assets/imgs/games/no-cover.png' }}" alt="Cover for {{ game.title }}" loading="lazy">
        <div>
          <strong>{{ game.title }}</strong>
          <span>{{ game.platformName }}</span>
        </div>
      </article>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if gamesOwned.favouriteGames and gamesOwned.favouriteGames.length %}
<section class="games-section games-favourites">
  <div class="games-section-heading">
    <div>
      <p class="games-eyebrow">♡ forever pile</p>
      <h2>Favourites</h2>
    </div>
    <p class="games-section-note">the ones I actually want to show off</p>
  </div>

  <div class="current-shelf">
    {% for game in gamesOwned.favouriteGames %}
      {% if loop.index <= 8 %}
      <article class="current-game">
        <img src="{{ game.image or '/assets/imgs/games/no-cover.png' }}" alt="Cover for {{ game.title }}" loading="lazy">
        <div>
          <strong>{{ game.title }}</strong>
          <span>{{ game.platformName }}</span>
        </div>
      </article>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="games-section">
  <div class="games-section-heading">
    <div>
      <p class="games-eyebrow">browse the shelves</p>
      <h2>By platform</h2>
    </div>
    <p class="games-section-note">physical, digital, or both — kept together</p>
  </div>

  <div class="platform-grid">
    {% for p in gamesOwned.platforms %}
      <a class="platform-card" href="/games/{{ p.slug }}/">
        <div class="platform-card__top">
          <span class="platform-sticker" aria-hidden="true">
            {% if "Nintendo" in p.platform or p.platform == "Wii" or p.platform == "Wii U" or "Game Boy" in p.platform %}N
            {% elif "PlayStation" in p.platform %}PS
            {% elif "Xbox" in p.platform %}XB
            {% elif p.platform == "Windows PC" or p.platform == "SteamVR" %}PC
            {% else %}♡{% endif %}
          </span>
          <span class="platform-arrow" aria-hidden="true">↗</span>
        </div>

        <div class="platform-main">
          <h3 class="platform-name">{{ p.platform }}</h3>
          <p class="platform-count">
            {{ p.totalGames }} title{% if p.totalGames != 1 %}s{% endif %}
            {% if p.totalCopies != p.totalGames %} · {{ p.totalCopies }} copies{% endif %}
          </p>
        </div>

        <div class="platform-breakdown" aria-label="Ownership breakdown">
          {% if p.physicalCount %}<span>physical {{ p.physicalCount }}</span>{% endif %}
          {% if p.digitalCount %}<span>digital {{ p.digitalCount }}</span>{% endif %}
          {% if p.bothCount %}<span class="platform-breakdown__both">both {{ p.bothCount }}</span>{% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% if gamesOwned.attribution %}
  <p class="platform-attrib">
    Cover artwork from
    <a href="{{ gamesOwned.attribution.url }}" target="_blank" rel="noopener">SteamGridDB</a>.
    Collection details come from my own sheet.
  </p>
{% endif %}
