---
title: "Games"
layout: layouts/gamesBase.njk
permalink: /games/
pageClass: games-index
customcss:
  - /assets/css/games/index.css
---

<section class="games-home-hero">
  <div class="games-home-hero__copy">
    <p class="games-eyebrow">the game shelf ♡</p>
    <h1>Games I play, track & collect.</h1>
    <p>
      My Playnite library keeps activity from different platforms together, while
      physical ownership lives in its own collection. Being tracked here means a
      game is part of my gaming history — not automatically that I own it digitally.
    </p>

    <div class="games-home-hero__chips" aria-label="Library sources">
      <span>Playnite activity</span>
      <span>SteamGridDB artwork</span>
      <span>physical shelf separate</span>
    </div>
  </div>

  <aside class="games-home-hero__note" aria-label="How this collection works">
    <span class="games-home-hero__pin" aria-hidden="true">✿</span>
    <strong>how the shelf works</strong>
    <p>Playnite tells me what I play. My physical list tells me what is actually on my shelves.</p>
  </aside>
</section>

<section class="games-stats" aria-label="Game library totals">
  <div class="games-stat">
    <span class="games-stat__label">tracked</span>
    <strong>{{ gamesOwned.trackedCount }}</strong>
    <span>Playnite entries</span>
  </div>
  <div class="games-stat">
    <span class="games-stat__label">played</span>
    <strong>{{ gamesOwned.playedCount }}</strong>
    <span>with activity</span>
  </div>
  <div class="games-stat">
    <span class="games-stat__label">shelves</span>
    <strong>{{ gamesOwned.platforms.length }}</strong>
    <span>platforms</span>
  </div>
  <div class="games-stat">
    <span class="games-stat__label">physical</span>
    <strong>{{ gamesOwned.physicalCount }}</strong>
    <span>titles logged</span>
  </div>
  {% if gamesOwned.totalPlaytime %}
  <div class="games-stat games-stat--wide">
    <span class="games-stat__label">time spent</span>
    <strong>{{ gamesOwned.totalPlaytime }}</strong>
    <span>tracked playtime</span>
  </div>
  {% endif %}
</section>

{% if gamesOwned.currentGames and gamesOwned.currentGames.length %}
<section class="games-section games-current">
  <div class="games-section-heading">
    <div>
      <p class="games-eyebrow">recent activity</p>
      <h2>Recently played</h2>
    </div>
    <p class="games-section-note">the latest things Playnite has seen me touch</p>
  </div>

  <div class="recent-games">
    {% for game in gamesOwned.currentGames %}
      {% if loop.index <= 8 %}
      <article class="recent-game">
        <div class="recent-game__cover">
          <img src="{{ game.image or '/assets/imgs/games/no-cover.png' }}" alt="Cover for {{ game.title }}" loading="lazy">
          {% if game.favourite %}<span class="recent-game__heart" aria-label="Favourite">♥</span>{% endif %}
        </div>
        <div class="recent-game__body">
          <p class="recent-game__platform">{{ game.platformName }}</p>
          <h3>{{ game.title }}</h3>
          <div class="recent-game__meta">
            {% if game.playtime %}<span>{{ game.playtime }}</span>{% endif %}
            {% if game.lastPlayedLabel %}<span>{{ game.lastPlayedLabel }}</span>{% endif %}
          </div>
        </div>
      </article>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

{% if gamesOwned.favouriteGames and gamesOwned.favouriteGames.length %}
<section class="games-section games-favourites">
  <div class="games-section-heading">
    <div>
      <p class="games-eyebrow">♡ forever pile</p>
      <h2>Favourites</h2>
    </div>
    <p class="games-section-note">the ones marked with a little heart</p>
  </div>

  <div class="favourite-strip">
    {% for game in gamesOwned.favouriteGames %}
      {% if loop.index <= 10 %}
      <a class="favourite-game" href="/games/{{ game.platformSlug }}/">
        <img src="{{ game.image or '/assets/imgs/games/no-cover.png' }}" alt="Cover for {{ game.title }}" loading="lazy">
        <span>{{ game.title }}</span>
      </a>
      {% endif %}
    {% endfor %}
  </div>
</section>
{% endif %}

<section class="games-section">
  <div class="games-section-heading">
    <div>
      <p class="games-eyebrow">browse the shelves</p>
      <h2>By platform</h2>
    </div>
    <p class="games-section-note">one shelf for every platform in the library</p>
  </div>

  <div class="platform-grid">
    {% for p in gamesOwned.platforms %}
      <a class="platform-card" href="/games/{{ p.slug }}/">
        <div class="platform-card__top">
          <span class="platform-sticker" aria-hidden="true">
            {% if "Nintendo" in p.platform or p.platform == "Wii" or p.platform == "Wii U" or "Game Boy" in p.platform %}N
            {% elif "PlayStation" in p.platform %}PS
            {% elif "Xbox" in p.platform %}XB
            {% elif p.platform == "Windows PC" or p.platform == "SteamVR" %}PC
            {% else %}♡{% endif %}
          </span>
          <span class="platform-arrow" aria-hidden="true">↗</span>
        </div>

        <div class="platform-main">
          <h3 class="platform-name">{{ p.platform }}</h3>
          <p class="platform-count">
            {{ p.totalGames }} entr{% if p.totalGames == 1 %}y{% else %}ies{% endif %}
            {% if p.totalPlaytime %} · {{ p.totalPlaytime }}{% endif %}
          </p>
        </div>

        <div class="platform-breakdown" aria-label="Platform details">
          {% if p.playedCount %}<span>{{ p.playedCount }} played</span>{% endif %}
          {% if p.favouriteCount %}<span>♥ {{ p.favouriteCount }}</span>{% endif %}
          {% if p.physicalCount %}<span class="platform-breakdown__physical">physical {{ p.physicalCount }}</span>{% endif %}
        </div>
      </a>
    {% endfor %}
  </div>
</section>

{% if gamesOwned.attribution %}
  <p class="platform-attrib">
    Activity comes from Playnite. Physical ownership comes only from my physical collection.
    Cover artwork from <a href="{{ gamesOwned.attribution.url }}" target="_blank" rel="noopener">SteamGridDB</a>.
  </p>
{% endif %}
