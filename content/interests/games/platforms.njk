---
pagination:
  data: gamesOwned.platforms
  size: 1
  alias: platform

permalink: /games/{{ platform.slug }}/
layout: layouts/gamesBase.njk
pageClass: games-platform
customcss:
  - /assets/css/games/platform.css
---

<section class="platform-hero">
  <a class="platform-back" href="/games/">← all shelves</a>
  <p class="games-eyebrow">platform shelf</p>
  <div class="platform-hero__title-row">
    <h1>{{ platform.platform }}</h1>
    <span class="platform-hero__count">{{ platform.totalGames }}</span>
  </div>
  <div class="platform-summary" aria-label="Platform summary">
    <span>{{ platform.playedCount }} played</span>
    {% if platform.totalPlaytime %}<span>{{ platform.totalPlaytime }} tracked</span>{% endif %}
    {% if platform.favouriteCount %}<span>♥ {{ platform.favouriteCount }} favourites</span>{% endif %}
    {% if platform.physicalCount %}<span>{{ platform.physicalCount }} physical</span>{% endif %}
  </div>
</section>

<div class="games-toolbar" data-games-toolbar>
  <label class="games-search">
    <span class="sr-only">Search this platform</span>
    <span aria-hidden="true">⌕</span>
    <input type="search" placeholder="find a game..." data-game-search autocomplete="off">
  </label>

  <div class="games-filters" aria-label="Filter games">
    <button type="button" class="games-filter is-active" data-game-filter="all">all</button>
    <button type="button" class="games-filter" data-game-filter="played">played</button>
    <button type="button" class="games-filter" data-game-filter="favourite">favourites</button>
    <button type="button" class="games-filter" data-game-filter="physical">physical</button>
  </div>
</div>

<p class="games-results" aria-live="polite"><span data-visible-count>{{ platform.totalGames }}</span> showing</p>

<div class="games-grid" data-games-grid>
  {% for game in platform.games %}
    {% set cover = game.image or "/assets/imgs/games/no-cover.png" %}

    <article
      class="game-card"
      data-game-card
      data-title="{{ game.title | lower }}"
      data-played="{% if game.hasActivity %}true{% else %}false{% endif %}"
      data-favourite="{% if game.favourite %}true{% else %}false{% endif %}"
      data-physical="{% if game.ownsPhysical %}true{% else %}false{% endif %}"
    >
      <div class="game-cover-wrap">
        <img class="game-cover" src="{{ cover }}" alt="Cover for {{ game.title }}" loading="lazy">

        <div class="game-cover-badges">
          {% if game.ownsPhysical %}<span class="game-badge game-badge--physical">physical</span>{% endif %}
          {% if game.isInstalled %}<span class="game-badge game-badge--installed">installed</span>{% endif %}
        </div>

        {% if game.favourite %}
          <span class="game-favourite" title="Favourite" aria-label="Favourite game">♥</span>
        {% endif %}
      </div>

      <div class="game-card__body">
        <div class="game-card__heading">
          <h2>{{ game.title }}</h2>
          {% if game.year %}<span class="game-year">{{ game.year }}</span>{% endif %}
        </div>

        <div class="game-card__activity">
          {% if game.playtime %}
            <span class="game-activity-pill"><strong>{{ game.playtime }}</strong> played</span>
          {% endif %}
          {% if game.lastPlayedLabel %}
            <span class="game-activity-pill">last {{ game.lastPlayedLabel }}</span>
          {% endif %}
        </div>

        {% if game.sourceName %}
          <p class="game-source">{{ game.sourceName }}</p>
        {% endif %}

        {% if game.genres and game.genres.length %}
          <div class="game-genres" aria-label="Genres">
            {% for genre in game.genres %}
              {% if loop.index <= 3 %}<span>{{ genre }}</span>{% endif %}
            {% endfor %}
          </div>
        {% endif %}

        {% if game.copies and game.copies.length %}
          <details class="game-copies">
            <summary>
              {% if game.physicalCopyCount > 1 %}
                {{ game.physicalCopyCount }} physical copies
              {% else %}
                physical copy details
              {% endif %}
            </summary>

            <ul>
              {% for copy in game.copies %}
                <li>
                  <div class="game-copy__heading">
                    <strong>Physical{% if copy.quantity > 1 %} ×{{ copy.quantity }}{% endif %}</strong>
                    {% if copy.edition %}<span>{{ copy.edition }}</span>{% endif %}
                  </div>

                  {% if copy.region or copy.packaging %}
                  <p class="game-copy__meta">
                    {% if copy.region %}<span>{{ copy.region }}</span>{% endif %}
                    {% if copy.packaging %}<span>{{ copy.packaging }}</span>{% endif %}
                  </p>
                  {% endif %}

                  {% if copy.notes %}<p class="game-copy__notes">{{ copy.notes }}</p>{% endif %}
                </li>
              {% endfor %}
            </ul>
          </details>
        {% endif %}
      </div>
    </article>
  {% endfor %}
</div>

<p class="games-empty" data-games-empty hidden>nothing on this shelf matches that ♡</p>

<div class="platform-footer">
  <a class="platform-back platform-back--bottom" href="/games/">← back to all shelves</a>

  {% if gamesOwned.attribution %}
    <p class="platform-attrib">
      Cover artwork from <a href="{{ gamesOwned.attribution.url }}" target="_blank" rel="noopener">SteamGridDB</a>.
    </p>
  {% endif %}
</div>

<script>
(() => {
  const cards = [...document.querySelectorAll("[data-game-card]")];
  const buttons = [...document.querySelectorAll("[data-game-filter]")];
  const search = document.querySelector("[data-game-search]");
  const count = document.querySelector("[data-visible-count]");
  const empty = document.querySelector("[data-games-empty]");

  if (!cards.length) return;

  let filter = "all";
  let query = "";

  function applyFilters() {
    let visible = 0;

    cards.forEach((card) => {
      const matchesSearch = !query || card.dataset.title.includes(query);
      const matchesFilter = filter === "all" || card.dataset[filter] === "true";
      const show = matchesSearch && matchesFilter;

      card.hidden = !show;
      if (show) visible++;
    });

    if (count) count.textContent = visible;
    if (empty) empty.hidden = visible !== 0;
  }

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      filter = button.dataset.gameFilter;
      buttons.forEach((item) => item.classList.toggle("is-active", item === button));
      applyFilters();
    });
  });

  search?.addEventListener("input", () => {
    query = search.value.trim().toLowerCase();
    applyFilters();
  });
})();
</script>
