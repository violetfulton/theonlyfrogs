---
layout: sofiBase.njk
title: Sofi Card Cabinet
permalink: /interests/sofi/
---
<section class="intro" aria-labelledby="page-title">
  <div class="intro-copy"><span class="eyebrow">Violet's digital card binder</span><h1 id="page-title">Sofi card<br><em>cabinet.</em> <span class="heading-heart" aria-hidden="true">♡</span></h1><p>A pocket for my favourite characters,<br>pretty cards & tiny treasures.</p><div class="mini-stamps" aria-hidden="true"><span>collected with love</span><span>🐸</span><span>keep forever ♡</span></div></div>
  <aside class="binder-note"><span class="note-pin" aria-hidden="true">✿</span><span class="eyebrow">Filed under</span><p>little things<br>that make me<br><em>happy.</em></p><span class="note-signature">— onlyfrogs ♡</span></aside>
</section>
<section class="collection-stats" aria-label="Collection summary">
  <div><strong id="stat-total">{{ sofiCards | length }}</strong><span>cards in my binder</span></div>
  <div><strong id="stat-series">—</strong><span>different worlds</span></div>
  <div><strong id="stat-lowest">—</strong><span>lowest generation</span></div>
  <div><strong id="stat-3d">—</strong><span>3D treasures</span></div>
</section>
<section id="binder" class="binder" aria-labelledby="binder-title">
  <div class="binder-top"><div><span class="eyebrow">the showcase</span><h2 id="binder-title">A peek inside my pockets</h2></div><button id="draw-card" class="pill" type="button" hidden>✦ draw a card</button></div>
  <div class="controls" id="sofi-controls" hidden>
    <div class="tabs" aria-label="Card selection"><button class="tab active" type="button" data-filter="showcase" aria-pressed="true">♡ showcase</button><button class="tab" type="button" data-filter="all" aria-pressed="false">all cards</button><button class="tab" type="button" data-filter="favourites" aria-pressed="false">♡ favourites</button><button class="tab" type="button" data-filter="low" aria-pressed="false">gen 1–10</button><button class="tab" type="button" data-filter="event" aria-pressed="false">✦ events</button></div>
    <div class="filter-row"><label class="search-label"><span class="sr-only">Search cards</span><input id="card-search" type="search" placeholder="Find a character, series or code…"></label><label><span class="sr-only">Tag</span><select id="tag-filter"><option value="">Any tag</option></select></label><label><span class="sr-only">Series</span><select id="series-filter"><option value="">Every series</option></select></label><label><span class="sr-only">Card type</span><select id="type-filter"><option value="">Every type</option><option>2D</option><option>3D</option><option>GIF</option><option value="unknown">Unspecified</option></select></label><label><span class="sr-only">Sort cards</span><select id="card-sort"><option value="name">A → Z</option><option value="gen">Lowest gen first</option></select></label></div>
  </div>
  <p id="visible-count" class="result-count" aria-live="polite">{{ sofiCards | length }} little treasures</p>
  <div class="card-grid" id="card-grid">
    {% for card in sofiCards %}
    <article class="sofi-card" data-code="{{ card.code | escape }}" data-character="{{ card.character | escape }}" data-series="{{ card.series | escape }}" data-gen="{{ card.gen | escape }}" data-type="{{ card.type | escape }}" data-event="{{ card.event | escape }}" data-is-event="{{ card.isEvent | escape }}" data-element="{{ card.element | escape }}" data-frame="{{ card.frame | escape }}" data-glow="{{ card.glow | escape }}" data-note="{{ card.note | escape }}" data-favourite="{{ card.favourite | escape }}" data-tags="{{ card.tags | dump | escape }}">
      <div class="pocket"><div class="pocket-badges">{% if card.type %}<span>{{ card.type | escape }}</span>{% endif %}{% if card.favourite %}<span class="heart-badge" aria-label="Favourite">♡</span>{% endif %}</div>
        {% if card.image %}<img class="card-art" data-src="{{ card.image | escape }}" alt="{{ card.character | escape }} Sofi card" loading="lazy" decoding="async" hidden>{% endif %}
        <div class="card-placeholder"><span class="placeholder-flower" aria-hidden="true">✿</span><span class="placeholder-name">{{ card.character | escape }}</span><span class="placeholder-code">{{ card.code | escape }}</span><span class="placeholder-bottom" aria-hidden="true">♡</span></div>
      </div>
      <div class="card-caption"><p class="card-series">{{ card.series | escape }}</p><h3>{{ card.character | escape }}</h3><div class="card-meta"><span class="gen-badge">gen {{ card.gen | escape }}</span><code>{{ card.code | escape }}</code></div><button class="card-open" type="button" data-open="{{ card.code | escape }}" hidden aria-label="View {{ card.character | escape }}, card {{ card.code | escape }}">open pocket <span aria-hidden="true">↗</span></button></div>
    </article>
    {% endfor %}
  </div>
  <nav id="gallery-pages" class="gallery-pages" aria-label="Collection pages" hidden><button id="gallery-prev" class="pill" type="button">← Previous</button><span id="gallery-page" class="result-count"></span><button id="gallery-next" class="pill" type="button">Next →</button></nav>
  <p id="no-results" class="empty-state" hidden>No cards in this pocket. Try another filter ♡</p>
  {% if not sofiCards | length %}<p class="empty-state">A new binder, ready for little treasures ♡</p>{% endif %}
</section>
<dialog id="card-dialog" aria-labelledby="dialog-name"><button class="dialog-close" type="button" aria-label="Close card">×</button><div class="dialog-layout"><div id="dialog-art" class="dialog-art"></div><div class="dialog-copy"><span class="eyebrow">a treasure from my binder</span><h2 id="dialog-name"></h2><p id="dialog-series"></p><dl id="dialog-facts"></dl><p id="dialog-note" class="personal-note" hidden></p><button id="copy-command" class="pill" type="button">copy sv command</button><p id="copy-status" class="copy-status" role="status"></p></div></div></dialog>
