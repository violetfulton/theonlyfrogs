---
layout: sofiBase.njk
title: Sofi Card Cabinet
permalink: /sofi/
---
<section id="binder" class="binder" aria-labelledby="page-title">
  <div class="binder-top"><h1 id="page-title">Sofi cards <span aria-hidden="true">♡</span></h1><button id="draw-card" class="pill" type="button" hidden>✦ draw a card</button></div>
  <div class="controls" id="sofi-controls" hidden>
    <div id="tag-tabs" class="tabs tag-tabs" role="group" aria-label="Filter by collection tag" data-hidden-tags="{{ sofiTags.hidden | dump | escape }}">
      <button class="tab active" type="button" data-tag="" aria-pressed="true">All cards</button>
      {% for tag in sofiTags.tags %}<button class="tab" type="button" data-tag="{{ tag.name | escape }}" data-icon="{{ tag.icon | escape }}" aria-pressed="false">{{ tag.icon | escape }} {{ tag.name | escape }}</button>{% endfor %}
    </div>
    <div class="filter-row">
      <label class="search-label"><span class="sr-only">Search cards</span><input id="card-search" type="search" placeholder="Search character, series or code…"></label>
      <label><span class="sr-only">Cards per page</span><select id="page-size"><option value="15">15 per page</option><option value="30" selected>30 per page</option><option value="all">All on one page</option></select></label>
      <label><span class="sr-only">Sort cards</span><select id="card-sort"><option value="name">A → Z</option><option value="gen">Lowest gen first</option></select></label>
    </div>
    <details class="extra-filters"><summary>More filters</summary><div class="filter-row">
      <label><span class="sr-only">Series</span><select id="series-filter"><option value="">Every series</option></select></label>
      <label><span class="sr-only">Card type</span><select id="type-filter"><option value="">Every type</option><option>2D</option><option>3D</option><option>GIF</option><option value="unknown">Unspecified</option></select></label>
      <label><span class="sr-only">Card selection</span><select id="selection-filter"><option value="all">Every card</option><option value="favourites">Favourites</option><option value="low">Gen 1–10</option><option value="event">Event cards</option></select></label>
    </div></details>
  </div>
  <p id="visible-count" class="result-count" aria-live="polite">{{ sofiCards | length }} little treasures</p>
  <div class="card-grid" id="card-grid">
    {% for card in sofiCards %}
    <article class="sofi-card" data-code="{{ card.code | escape }}" data-character="{{ card.character | escape }}" data-series="{{ card.series | escape }}" data-gen="{{ card.gen | escape }}" data-type="{{ card.type | escape }}" data-event="{{ card.event | escape }}" data-is-event="{{ card.isEvent | escape }}" data-element="{{ card.element | escape }}" data-frame="{{ card.frame | escape }}" data-glow="{{ card.glow | escape }}" data-note="{{ card.note | escape }}" data-favourite="{{ card.favourite | escape }}" data-tags="{{ card.tags | dump | escape }}">
      <div class="pocket"><div class="pocket-badges">{% if card.type %}<span>{{ card.type | escape }}</span>{% endif %}{% if card.favourite %}<span class="heart-badge" aria-label="Favourite">♡</span>{% endif %}</div>
        {% if card.image %}<img class="card-art" data-src="{{ card.image | escape }}" alt="{{ card.character | escape }} Sofi card" loading="lazy" decoding="async" hidden>{% endif %}
        <div class="card-placeholder"><span class="placeholder-flower" aria-hidden="true">✿</span><span class="placeholder-name">{{ card.character | escape }}</span><span class="placeholder-code">{{ card.code | escape }}</span><span class="placeholder-bottom" aria-hidden="true">♡</span></div>
      </div>
      <div class="card-caption"><p class="card-series">{{ card.series | escape }}</p><h3>{{ card.character | escape }}</h3><div class="card-meta"><span class="gen-badge">{% if card.gen %}gen {{ card.gen | escape }}{% else %}gen ?{% endif %}</span><code>{{ card.code | escape }}</code></div><button class="card-open" type="button" data-open="{{ card.code | escape }}" hidden aria-label="View {{ card.character | escape }}, card {{ card.code | escape }}">open pocket <span aria-hidden="true">↗</span></button></div>
    </article>
    {% endfor %}
  </div>
  <nav id="gallery-pages" class="gallery-pages" aria-label="Collection pages" hidden><button id="gallery-prev" class="pill" type="button">← Previous</button><span id="gallery-page" class="result-count"></span><button id="gallery-next" class="pill" type="button">Next →</button></nav>
  <p id="no-results" class="empty-state" hidden>No cards in this pocket. Try another filter ♡</p>
  {% if not sofiCards | length %}<p class="empty-state">A new binder, ready for little treasures ♡</p>{% endif %}
</section>
<dialog id="card-dialog" aria-labelledby="dialog-name"><button class="dialog-close" type="button" aria-label="Close card">×</button><div class="dialog-layout"><div id="dialog-art" class="dialog-art"></div><div class="dialog-copy"><span class="eyebrow">a treasure from my binder</span><h2 id="dialog-name"></h2><p id="dialog-series"></p><dl id="dialog-facts"></dl><p id="dialog-note" class="personal-note" hidden></p><button id="copy-command" class="pill" type="button">copy sv command</button><p id="copy-status" class="copy-status" role="status"></p></div></div></dialog>
