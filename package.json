{
  "name": "theonlyfrogs",
  "version": "1.0.0",
  "description": "Personal site built with Eleventy and Discogs integrations.",
  "type": "module",
"scripts": {
  "dev": "eleventy --serve",
  "start": "eleventy --serve",

  "build": "eleventy",
  "build:fresh": "npm run fetch:discogs && npm run build",

  "fetch:discogs": "node content/_scripts/fetchDiscogsCache.js",
  "fetch:accf-ra": "node content/_scripts/fetchAccfRetroAchievements.mjs",
  "fetch:game-covers": "node content/_scripts/fetchGameCovers.mjs"
},
  "dependencies": {
    "@11ty/eleventy-fetch": "^5.1.0",
    "cheerio": "^1.2.0",
    "csv-parse": "^6.1.0",
    "dotenv": "^17.2.2",
    "jsonwebtoken": "^9.0.2",
    "luxon": "^3.4.4",
    "node-fetch": "^3.3.2",
    "psn-api": "^2.15.0",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.0.0",
    "eslint": "^9.12.0",
    "prettier": "^3.3.3"
  }
}
